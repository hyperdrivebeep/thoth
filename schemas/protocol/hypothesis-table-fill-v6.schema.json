          "type": "string"
        },
        "knowledge_state": {
          "enum": [
            "PREDICTED",
            "UNKNOWN"
          ],
          "title": "Knowledge State",
          "type": "string"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
