{
  "$defs": {
    "CausalDepth": {
      "enum": [
        "PROXIMATE",
        "INTERMEDIATE",
        "SYSTEMIC",
        "UNDETERMINED"
      ],
      "title": "CausalDepth",
      "type": "string"
    },
    "CausalLocus": {
      "enum": [
        "INPUT_MATERIAL_DATA",
        "MEASUREMENT_OBSERVATION",
        "METHOD_DESIGN_IMPLEMENTATION",
        "COMPONENT_INTERFACE_SYSTEM",
        "ENVIRONMENT_CONTEXT",
        "HUMAN_ORGANIZATION_EXECUTION",
        "OTHER_WITH_DESCRIPTION"
      ],
      "title": "CausalLocus",
      "type": "string"
    },
    "CounterReviewTerminal": {
      "enum": [
        "SUPPORTED",
        "ELIMINATED_WITHIN_SCOPE",
        "UNRESOLVED_NO_RESULTS",
        "UNRESOLVED_INDEPENDENCE",
        "UNRESOLVED_AUTHORITY",
        "UNRESOLVED_TEMPORAL",
        "UNRESOLVED_PROHIBITED_CONTEXT",
        "UNRESOLVED_POLICY_BLOCKED",
        "UNRESOLVED_FAILED",
        "UNRESOLVED_CONFLICT"
      ],
      "title": "CounterReviewTerminal",
      "type": "string"
    },
    "DiscriminatingTestV4": {
      "additionalProperties": false,
      "properties": {
        "estimated_cost": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost"
        },
        "expected_by_hypothesis": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ExpectedResultV4"
          },
          "maxItems": 10,
          "title": "Expected By Hypothesis",
          "type": "array"
        },
        "expected_if_alternative": {
          "title": "Expected If Alternative",
          "type": "string"
        },
        "expected_if_true": {
          "title": "Expected If True",
          "type": "string"
        },
        "procedure_candidate": {
          "title": "Procedure Candidate",
          "type": "string"
        },
        "reversibility": {
          "$ref": "#/$defs/Reversibility"
        },
        "risk_tier": {
          "$ref": "#/$defs/RiskTier"
        },
        "test_id": {
          "title": "Test Id",
          "type": "string"
        }
      },
      "required": [
        "test_id",
        "procedure_candidate",
        "expected_if_true",
        "expected_if_alternative",
        "risk_tier",
        "reversibility"
      ],
      "title": "DiscriminatingTestV4",
      "type": "object"
    },
    "EvidenceEffect": {
      "enum": [
        "SUPPORT",
        "COUNTER",
        "NEUTRAL"
      ],
      "title": "EvidenceEffect",
      "type": "string"
    },
    "ExpectedRange": {
      "additionalProperties": false,
      "properties": {
        "lower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Lower"
        },
        "measure": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Measure",
          "type": "string"
        },
        "type": {
          "const": "RANGE",
          "title": "Type",
          "type": "string"
        },
        "unit": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "upper": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Upper"
        }
      },
      "required": [
        "type",
        "measure",
        "unit",
        "lower",
        "upper"
      ],
      "title": "ExpectedRange",
      "type": "object"
    },
    "ExpectedResultV4": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "default": [],
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "maxItems": 5,
          "title": "Basis",
          "type": "array"
        },
        "expected": {
          "anyOf": [
            {
              "maxLength": 80,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected"
        },
        "hypothesis_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "knowledge_state": {
          "enum": [
            "PREDICTED",
            "UNKNOWN"
          ],
          "title": "Knowledge State",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "knowledge_state",
        "expected"
      ],
      "title": "ExpectedResultV4",
      "type": "object"
    },
    "HypothesisCriticalReview": {
      "additionalProperties": false,
      "properties": {
        "counterevidence_added_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Counterevidence Added Refs",
          "type": "array"
        },
        "gate_review_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Gate Review Id",
          "type": "string"
        },
        "investigation_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Investigation Id",
          "type": "string"
        },
        "plan_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Plan Id",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "review_digest": {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "title": "Review Digest",
          "type": "string"
        },
        "semantic_truth_certified": {
          "const": false,
          "default": false,
          "title": "Semantic Truth Certified",
          "type": "boolean"
        },
        "support_added_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Support Added Refs",
          "type": "array"
        },
        "terminal": {
          "$ref": "#/$defs/CounterReviewTerminal"
        }
      },
      "required": [
        "investigation_id",
        "plan_id",
        "gate_review_id",
        "terminal",
        "reasons",
        "review_digest"
      ],
      "title": "HypothesisCriticalReview",
      "type": "object"
    },
    "HypothesisExecutionAppraisal": {
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "title": "Action Id",
          "type": "string"
        },
        "appraisal_digest": {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "title": "Appraisal Digest",
          "type": "string"
        },
        "attempt_id": {
          "title": "Attempt Id",
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/EvidenceEffect",
          "default": "NEUTRAL"
        },
        "observation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Observation Refs",
          "type": "array"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "attempt_id",
        "observation_refs",
        "reason",
        "appraisal_digest"
      ],
      "title": "HypothesisExecutionAppraisal",
      "type": "object"
    },
    "HypothesisStatus": {
      "enum": [
        "DRAFT",
        "GROUNDED_CANDIDATE",
        "COUNTEREVIDENCE_CHECKED",
        "PREDICTION_BOUND",
        "TESTABLE",
        "EMPIRICALLY_UPDATED",
        "INCONCLUSIVE",
        "ELIMINATED_WITHIN_SCOPE"
      ],
      "title": "HypothesisStatus",
      "type": "string"
    },
    "HypothesisV4": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "causal_depth": {
          "$ref": "#/$defs/CausalDepth"
        },
        "contributing_loci": {
          "default": [],
          "items": {
            "$ref": "#/$defs/CausalLocus"
          },
          "title": "Contributing Loci",
          "type": "array"
        },
        "counterevidence_queries": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Counterevidence Queries",
          "type": "array"
        },
        "counterevidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Counterevidence Refs",
          "type": "array"
        },
        "critical_review": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisCriticalReview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "discriminating_tests": {
          "items": {
            "$ref": "#/$defs/DiscriminatingTestV4"
          },
          "title": "Discriminating Tests",
          "type": "array"
        },
        "execution_appraisal": {
          "anyOf": [
            {
              "$ref": "#/$defs/HypothesisExecutionAppraisal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "hypothesis_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Hypothesis Id",
          "type": "string"
        },
        "missing_evidence": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Missing Evidence",
          "type": "array"
        },
        "object_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Object Id",
          "type": "string"
        },
        "observed_problem": {
          "title": "Observed Problem",
          "type": "string"
        },
        "predicted_observations": {
          "items": {
            "type": "string"
          },
          "title": "Predicted Observations",
          "type": "array"
        },
        "prediction_proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/PredictionProposal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "primary_intent": {
          "anyOf": [
            {
              "enum": [
                "DIAGNOSTIC_CAUSAL",
                "EXPLANATORY_MECHANISTIC",
                "PREDICTIVE",
                "INTERVENTION_DESIGN",
                "EXPLORATORY"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Primary Intent"
        },
        "primary_locus": {
          "anyOf": [
            {
              "$ref": "#/$defs/CausalLocus"
            },
            {
              "type": "null"
            }
          ]
        },
        "refutation_conditions": {
          "default": [],
          "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 5,
          "title": "Refutation Conditions",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "scope_conditions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Scope Conditions",
          "type": "object"
        },
        "semantic_review_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Review Ref"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HypothesisStatus"
        },
        "support_evidence_refs": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Support Evidence Refs",
          "type": "array"
        },
        "uncertainty": {
          "title": "Uncertainty",
          "type": "string"
        }
      },
      "required": [
        "hypothesis_id",
        "object_id",
        "statement",
        "observed_problem",
        "primary_locus",
        "causal_depth",
        "scope_conditions",
        "support_evidence_refs",
        "counterevidence_refs",
        "assumptions",
        "uncertainty",
        "predicted_observations",
        "discriminating_tests",
        "status"
      ],
      "title": "HypothesisV4",
      "type": "object"
    },
    "PortfolioStatus": {
      "enum": [
        "DRAFT",
        "GROUNDED",
        "TESTABLE",
        "EMPIRICALLY_UPDATED"
      ],
      "title": "PortfolioStatus",
      "type": "string"
    },
    "PredictionProposal": {
      "additionalProperties": false,
      "properties": {
        "conditions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Conditions",
          "type": "object"
        },
        "expected_outcome": {
          "$ref": "#/$defs/ExpectedRange"
        },
        "measurement_contract_ref": {
          "maxLength": 260,
          "minLength": 1,
          "title": "Measurement Contract Ref",
          "type": "string"
        },
        "prespecification_state": {
          "enum": [
            "A_PRIORI",
            "BLINDED_AMENDMENT",
            "POST_HOC",
            "RETRODICTIVE",
            "UNKNOWN"
          ],
          "title": "Prespecification State",
          "type": "string"
        }
      },
      "required": [
        "measurement_contract_ref",
        "prespecification_state",
        "conditions",
        "expected_outcome"
      ],
      "title": "PredictionProposal",
      "type": "object"
    },
    "Reversibility": {
      "enum": [
        "FULL",
        "PARTIAL",
        "NONE"
      ],
      "title": "Reversibility",
      "type": "string"
    },
    "RiskTier": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4"
      ],
      "title": "RiskTier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "alternatives_considered": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Alternatives Considered",
      "type": "array"
    },
    "generated_from_head_set": {
      "pattern": "^[A-Fa-f0-9]{64}$",
      "title": "Generated From Head Set",
      "type": "string"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/HypothesisV4"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "next_checks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Next Checks",
      "type": "array"
    },
    "object_id": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Object Id",
      "type": "string"
    },
    "portfolio_id": {
      "title": "Portfolio Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/PortfolioStatus"
    },
    "uncertainty_reserve": {
      "default": "UNASSESSED",
      "title": "Uncertainty Reserve",
      "type": "string"
    }
  },
  "required": [
    "portfolio_id",
    "object_id",
    "hypotheses",
    "status",
    "generated_from_head_set"
  ],
  "title": "HypothesisPortfolioV4",
  "type": "object"
}
