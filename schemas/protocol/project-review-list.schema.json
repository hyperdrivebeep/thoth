{
  "$defs": {
    "BasisCurrentness": {
      "additionalProperties": false,
      "properties": {
        "execution_eligible": {
          "default": false,
          "title": "Execution Eligible",
          "type": "boolean"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "state": {
          "enum": [
            "CURRENT",
            "REVIEW_REQUIRED",
            "INVALIDATED",
            "UNKNOWN_BASIS",
            "UNAVAILABLE"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "BasisCurrentness",
      "type": "object"
    },
    "NextUserAction": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "NONE",
            "REVIEW_GAPS",
            "REVIEW_CURRENTNESS",
            "OPEN_RESULT_DETAIL",
            "START_FOLLOWUP",
            "UNSUPPORTED"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "basis": {
          "additionalProperties": true,
          "title": "Basis",
          "type": "object"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "requires_permission": {
          "default": false,
          "title": "Requires Permission",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "action_type",
        "label"
      ],
      "title": "NextUserAction",
      "type": "object"
    },
    "ProjectReviewItem": {
      "additionalProperties": false,
      "properties": {
        "currentness": {
          "$ref": "#/$defs/BasisCurrentness"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "next_user_action": {
          "$ref": "#/$defs/NextUserAction"
        },
        "priority": {
          "enum": [
            "HIGH",
            "MEDIUM",
            "LOW"
          ],
          "title": "Priority",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "request_revision_digest": {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "title": "Request Revision Digest",
          "type": "string"
        },
        "result_revision_digest": {
          "anyOf": [
            {
              "pattern": "^[A-Fa-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Revision Digest"
        },
        "thread_id": {
          "title": "Thread Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "project_id",
        "thread_id",
        "request_revision_digest",
        "title",
        "priority",
        "reason_codes",
        "currentness",
        "next_user_action"
      ],
      "title": "ProjectReviewItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assignment_supported": {
      "const": false,
      "default": false,
      "title": "Assignment Supported",
      "type": "boolean"
    },
    "contract_version": {
      "const": 2,
      "default": 2,
      "title": "Contract Version",
      "type": "integer"
    },
    "coverage": {
      "enum": [
        "COMPLETE_PAGE",
        "CONTINUATION",
        "LIMITED"
      ],
      "title": "Coverage",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/ProjectReviewItem"
      },
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "unread_supported": {
      "const": false,
      "default": false,
      "title": "Unread Supported",
      "type": "boolean"
    }
  },
  "required": [
    "project_id",
    "items",
    "coverage"
  ],
  "title": "ProjectReviewList",
  "type": "object"
}
