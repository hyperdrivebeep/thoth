{
  "$defs": {
    "AuthorityState": {
      "enum": [
        "UNCLASSIFIED",
        "INFORMAL",
        "OFFICIAL",
        "APPROVED",
        "SUPERSEDED",
        "NOT_ADMISSIBLE"
      ],
      "title": "AuthorityState",
      "type": "string"
    },
    "BasisCurrentness": {
      "additionalProperties": false,
      "properties": {
        "execution_eligible": {
          "default": false,
          "title": "Execution Eligible",
          "type": "boolean"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "state": {
          "enum": [
            "CURRENT",
            "REVIEW_REQUIRED",
            "INVALIDATED",
            "UNKNOWN_BASIS",
            "UNAVAILABLE"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "BasisCurrentness",
      "type": "object"
    },
    "CutoffState": {
      "enum": [
        "ELIGIBLE",
        "AFTER_CUTOFF",
        "UNKNOWN_TIME",
        "PROHIBITED_CONTEXT"
      ],
      "title": "CutoffState",
      "type": "string"
    },
    "EvidenceSpan": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Artifact Id",
          "type": "string"
        },
        "authority_state": {
          "$ref": "#/$defs/AuthorityState"
        },
        "cutoff_state": {
          "$ref": "#/$defs/CutoffState"
        },
        "exact_text": {
          "title": "Exact Text",
          "type": "string"
        },
        "extraction_method": {
          "title": "Extraction Method",
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "project_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_version_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Source Version Id",
          "type": "string"
        },
        "span_id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Span Id",
          "type": "string"
        },
        "support_state": {
          "$ref": "#/$defs/SupportState"
        },
        "text_sha256": {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "title": "Text Sha256",
          "type": "string"
        },
        "verification_state": {
          "$ref": "#/$defs/VerificationState"
        }
      },
      "required": [
        "span_id",
        "project_id",
        "artifact_id",
        "source_version_id",
        "locator",
        "exact_text",
        "text_sha256",
        "extraction_method",
        "support_state",
        "authority_state",
        "verification_state",
        "cutoff_state"
      ],
      "title": "EvidenceSpan",
      "type": "object"
    },
    "HistoryCoverage": {
      "additionalProperties": false,
      "properties": {
        "association": {
          "default": "EXACT",
          "enum": [
            "EXACT",
            "PARTIAL",
            "UNRESOLVED"
          ],
          "title": "Association",
          "type": "string"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "scan": {
          "default": "COMPLETE_PAGE",
          "enum": [
            "COMPLETE_PAGE",
            "CONTINUATION",
            "LIMITED"
          ],
          "title": "Scan",
          "type": "string"
        },
        "visibility": {
          "const": "AUTHORIZED_SUBSET",
          "default": "AUTHORIZED_SUBSET",
          "title": "Visibility",
          "type": "string"
        }
      },
      "title": "HistoryCoverage",
      "type": "object"
    },
    "SelectedEvidenceItem": {
      "additionalProperties": false,
      "properties": {
        "availability": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE",
            "BASIS_MISMATCH",
            "UNKNOWN_BASIS"
          ],
          "title": "Availability",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceSpan"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "span_id": {
          "title": "Span Id",
          "type": "string"
        }
      },
      "required": [
        "span_id",
        "availability"
      ],
      "title": "SelectedEvidenceItem",
      "type": "object"
    },
    "SelectedEvidencePage": {
      "additionalProperties": false,
      "properties": {
        "actor_scope_digest": {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "title": "Actor Scope Digest",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/SelectedEvidenceItem"
          },
          "title": "Items",
          "type": "array"
        },
        "limit": {
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Offset"
        },
        "offset": {
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "result_revision_digest": {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "title": "Result Revision Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "selected_count": {
          "minimum": 0,
          "title": "Selected Count",
          "type": "integer"
        }
      },
      "required": [
        "result_revision_digest",
        "actor_scope_digest",
        "selected_count",
        "offset",
        "limit",
        "items"
      ],
      "title": "SelectedEvidencePage",
      "type": "object"
    },
    "SourceLocator": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                      "type": "string"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                      "type": "string"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                      "type": "string"
                    }
                  ]
                },
                {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                      "type": "string"
                    }
                  ]
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        },
        "cell_range": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell Range"
        },
        "char_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char End"
        },
        "char_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Char Start"
        },
        "column_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column Index"
        },
        "file_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Path"
        },
        "json_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Json Pointer"
        },
        "line": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "paragraph": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paragraph"
        },
        "row_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row Index"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "sheet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sheet"
        },
        "structural_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Structural Node Id"
        },
        "xml_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xml Path"
        }
      },
      "title": "SourceLocator",
      "type": "object"
    },
    "SupportState": {
      "enum": [
        "DISCOVERED",
        "EXTRACTED",
        "SUPPORTED_CANDIDATE",
        "SUPPORTED",
        "CONTRADICTED",
        "REFUTED",
        "UNRESOLVED"
      ],
      "title": "SupportState",
      "type": "string"
    },
    "VerificationState": {
      "enum": [
        "NOT_CHECKED",
        "SCHEMA_VALID",
        "PROVENANCE_VALID",
        "DETERMINISTICALLY_VERIFIED",
        "VERIFICATION_FAILED"
      ],
      "title": "VerificationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "availability": {
      "enum": [
        "AVAILABLE",
        "PARTIAL",
        "UNAVAILABLE"
      ],
      "title": "Availability",
      "type": "string"
    },
    "basis_currentness": {
      "$ref": "#/$defs/BasisCurrentness"
    },
    "contract_version": {
      "const": 2,
      "default": 2,
      "title": "Contract Version",
      "type": "integer"
    },
    "coverage": {
      "$ref": "#/$defs/HistoryCoverage"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    },
    "execution_observation": {
      "const": "UNKNOWN",
      "default": "UNKNOWN",
      "title": "Execution Observation",
      "type": "string"
    },
    "manifest": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Manifest"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "operation_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation State"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "request": {
      "additionalProperties": true,
      "title": "Request",
      "type": "object"
    },
    "request_revision_digest": {
      "pattern": "^[A-Fa-f0-9]{64}$",
      "title": "Request Revision Digest",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "result_revision_digest": {
      "anyOf": [
        {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Revision Digest"
    },
    "selected_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectedEvidencePage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "thread_id": {
      "title": "Thread Id",
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "thread_id",
    "request_revision_digest",
    "operation_id",
    "request",
    "availability",
    "basis_currentness",
    "coverage"
  ],
  "title": "HistoricalResultView",
  "type": "object"
}
