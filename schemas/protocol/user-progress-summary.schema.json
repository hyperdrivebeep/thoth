{
  "$defs": {
    "BasisCurrentness": {
      "additionalProperties": false,
      "properties": {
        "execution_eligible": {
          "default": false,
          "title": "Execution Eligible",
          "type": "boolean"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "state": {
          "enum": [
            "CURRENT",
            "REVIEW_REQUIRED",
            "INVALIDATED",
            "UNKNOWN_BASIS",
            "UNAVAILABLE"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "BasisCurrentness",
      "type": "object"
    },
    "NextUserAction": {
      "additionalProperties": false,
      "properties": {
        "action_type": {
          "enum": [
            "NONE",
            "REVIEW_GAPS",
            "REVIEW_CURRENTNESS",
            "OPEN_RESULT_DETAIL",
            "START_FOLLOWUP",
            "UNSUPPORTED"
          ],
          "title": "Action Type",
          "type": "string"
        },
        "basis": {
          "additionalProperties": true,
          "title": "Basis",
          "type": "object"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "requires_permission": {
          "default": false,
          "title": "Requires Permission",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        }
      },
      "required": [
        "action_type",
        "label"
      ],
      "title": "NextUserAction",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "currentness": {
      "$ref": "#/$defs/BasisCurrentness"
    },
    "next_user_action": {
      "$ref": "#/$defs/NextUserAction"
    },
    "progress_items": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Progress Items",
      "type": "array"
    },
    "recorded_checks": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Recorded Checks",
      "type": "array"
    },
    "remaining_gaps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Remaining Gaps",
      "type": "array"
    },
    "request_revision_digest": {
      "pattern": "^[A-Fa-f0-9]{64}$",
      "title": "Request Revision Digest",
      "type": "string"
    },
    "result_revision_digest": {
      "anyOf": [
        {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Revision Digest"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state": {
      "enum": [
        "PENDING_OR_NOT_PRODUCED",
        "IN_PROGRESS",
        "COMPLETE",
        "NEEDS_REVIEW",
        "HOLD",
        "FAILED",
        "CANCELLED",
        "UNKNOWN"
      ],
      "title": "State",
      "type": "string"
    },
    "unknowns": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unknowns",
      "type": "array"
    }
  },
  "required": [
    "request_revision_digest",
    "state",
    "currentness",
    "next_user_action"
  ],
  "title": "UserProgressSummary",
  "type": "object"
}
