{
  "$defs": {
    "ResearchResultBasis": {
      "additionalProperties": false,
      "properties": {
        "consumed_heads": {
          "additionalProperties": {
            "pattern": "^[A-Fa-f0-9]{64}$",
            "type": "string"
          },
          "title": "Consumed Heads",
          "type": "object"
        },
        "coverage": {
          "default": "UNKNOWN",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "UNKNOWN"
          ],
          "title": "Coverage",
          "type": "string"
        },
        "cutoff_at": {
          "format": "date-time",
          "title": "Cutoff At",
          "type": "string"
        },
        "memory_revision_refs": {
          "default": [],
          "items": {
            "pattern": "^[A-Fa-f0-9]{64}$",
            "type": "string"
          },
          "title": "Memory Revision Refs",
          "type": "array"
        },
        "object_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RevisionRef"
          },
          "title": "Object Refs",
          "type": "array"
        },
        "policy_digest": {
          "pattern": "^[A-Fa-f0-9]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "produced_final_heads": {
          "additionalProperties": {
            "pattern": "^[A-Fa-f0-9]{64}$",
            "type": "string"
          },
          "title": "Produced Final Heads",
          "type": "object"
        },
        "produced_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/RevisionRef"
          },
          "title": "Produced Refs",
          "type": "array"
        },
        "producer_receipt_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Producer Receipt Refs",
          "type": "array"
        },
        "reasons": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "request_ref": {
          "$ref": "#/$defs/RevisionRef"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_basis": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceBasisRef"
          },
          "title": "Source Basis",
          "type": "array"
        }
      },
      "required": [
        "request_ref",
        "policy_digest",
        "cutoff_at"
      ],
      "title": "ResearchResultBasis",
      "type": "object"
    },
    "RevisionRef": {
      "additionalProperties": false,
      "properties": {
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "entity_type": {
          "title": "Entity Type",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "revision_digest": {
          "title": "Revision Digest",
          "type": "string"
        },
        "revision_id": {
          "title": "Revision Id",
          "type": "string"
        },
        "schema_version": {
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "entity_type",
        "entity_id",
        "revision_id",
        "revision_digest"
      ],
      "title": "RevisionRef",
      "type": "object"
    },
    "SourceBasisRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "binding_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Binding Digest"
        },
        "grant_digest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grant Digest"
        },
        "source_version_id": {
          "title": "Source Version Id",
          "type": "string"
        },
        "span_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Span Id"
        },
        "text_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Sha256"
        }
      },
      "required": [
        "artifact_id",
        "source_version_id"
      ],
      "title": "SourceBasisRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_epoch": {
      "title": "Attempt Epoch",
      "type": "integer"
    },
    "basis_digest": {
      "title": "Basis Digest",
      "type": "string"
    },
    "completion": {
      "default": "CHECKPOINT",
      "enum": [
        "CHECKPOINT",
        "TERMINAL"
      ],
      "title": "Completion",
      "type": "string"
    },
    "gaps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    },
    "input_ids": {
      "items": {
        "type": "string"
      },
      "title": "Input Ids",
      "type": "array"
    },
    "next_steps": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Next Steps",
      "type": "array"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "phase": {
      "title": "Phase",
      "type": "string"
    },
    "record_kind": {
      "const": "CurrentResultManifest",
      "default": "CurrentResultManifest",
      "title": "Record Kind",
      "type": "string"
    },
    "record_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/RevisionRef"
      },
      "title": "Record Refs",
      "type": "array"
    },
    "request_ref": {
      "$ref": "#/$defs/RevisionRef"
    },
    "research_basis": {
      "$ref": "#/$defs/ResearchResultBasis"
    },
    "resource_uses": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Resource Uses",
      "type": "array"
    },
    "result": {
      "additionalProperties": true,
      "title": "Result",
      "type": "object"
    },
    "schema_version": {
      "const": "2.1.0",
      "default": "2.1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_basis": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Basis",
      "type": "object"
    },
    "source_context_digest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Context Digest"
    },
    "source_context_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Context Version"
    },
    "source_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "state": {
      "default": "PARTIAL",
      "enum": [
        "PARTIAL",
        "ASSESSED_FOR_REQUEST"
      ],
      "title": "State",
      "type": "string"
    },
    "terminal_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminal Reason"
    }
  },
  "required": [
    "request_ref",
    "operation_id",
    "attempt_epoch",
    "basis_digest",
    "phase",
    "input_ids",
    "research_basis"
  ],
  "title": "CurrentResultManifestV21",
  "type": "object"
}
