  "ReviseInput": {
    "$defs": {
      "HumanEffortEstimateInput": {
        "additionalProperties": false,
        "properties": {
          "dimension": {
            "enum": [
              "TIME",
              "COST_EFFORT"
            ],
            "title": "Dimension",
            "type": "string"
          },
          "band": {
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH",
              "UNKNOWN"
            ],
            "title": "Band",
            "type": "string"
          },
          "basis_text": {
            "default": "",
            "maxLength": 2000,
            "title": "Basis Text",
            "type": "string"
          },
          "assumptions": {
            "default": [],
            "items": {
              "type": "string"
            },
            "title": "Assumptions",
            "type": "array"
          }
        },
        "required": [
          "dimension",
          "band"
        ],
        "title": "HumanEffortEstimateInput",
        "type": "object"
      },
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "project_id": {
        "maxLength": 160,
        "minLength": 1,
        "title": "Project Id",
        "type": "string"
      },
      "action_id": {
        "maxLength": 160,
        "minLength": 1,
        "title": "Action Id",
        "type": "string"
      },
      "revision_digest": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 64,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Revision Digest"
      },
      "expected_revision_digest": {
        "maxLength": 64,
        "minLength": 64,
        "title": "Expected Revision Digest",
        "type": "string"
      },
      "patch": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Patch",
        "type": "object"
      },
      "evidence_refs": {
        "items": {
          "type": "string"
        },
        "title": "Evidence Refs",
        "type": "array"
      },
      "reason": {
        "maxLength": 5000,
        "minLength": 1,
        "title": "Reason",
        "type": "string"
      },
      "human_effort_estimates": {
        "default": [],
        "items": {
          "$ref": "#/$defs/HumanEffortEstimateInput"
        },
        "title": "Human Effort Estimates",
        "type": "array"
      },
      "estimator_ref": {
        "anyOf": [
          {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Estimator Ref"
      }
    },
    "required": [
      "project_id",
      "action_id",
      "expected_revision_digest",
      "evidence_refs",
      "reason"
    ],
    "title": "ReviseInput",
    "type": "object"
  },
